<!DOCTYPE html>
<html lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'uk' %>">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <%
    const shopName = 'FlowersGo';
    const pageTitle = typeof title === 'string' ? title.trim() : shopName;
    const documentTitle =
        pageTitle === shopName || pageTitle.endsWith(' - ' + shopName) || pageTitle.endsWith(' | ' + shopName)
            ? pageTitle
            : pageTitle + ' - ' + shopName;
    %>
    <title><%= documentTitle %></title>
    <script>
        (function () {
            try {
                if (localStorage.getItem('site-theme') === 'light') {
                    document.documentElement.classList.add('theme-light');
                }
            } catch (e) {}
        })();
    </script>
    <script type="application/json" id="headLocaleConfig"><%- JSON.stringify({
        lang: typeof lang === 'string' ? lang : 'uk',
        usdRate: typeof usdRate !== 'undefined' ? Number(usdRate) : 41.5,
        t: typeof localeDict !== 'undefined' && localeDict ? localeDict : {}
    }) %></script>
    <script>
        (function () {
            var el = document.getElementById('headLocaleConfig');
            var data = { lang: 'uk', usdRate: 41.5, t: {} };
            if (el && el.textContent) {
                try {
                    data = JSON.parse(el.textContent);
                } catch (err) {
                }
            }
            window.__locale = data;
        })();
    </script>
    <script src="/js/locale-money.js"></script>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/product.css" />
    <link rel="stylesheet" href="/css/theme-light.css" />
    <script src="/js/toast.js"></script>
    <script src="/js/nav-counts.js"></script>
    <script src="/js/form-progress.js"></script>
    <script src="/js/site-notify-auto.js"></script>
</head>
<body>
    <div class="site-flowers-bg" aria-hidden="true"></div>
    <a class="skip-link" href="#page-main"><%= typeof t === 'function' ? t('nav.skip') : 'Перейти до вмісту' %></a>
    <%- include('partials/header') %>
    <main class="main" id="page-main" tabindex="-1">
        <%- include(bodyPartial) %>
    </main>
    <% if (headerType !== 'admin' && headerType !== 'warehouse_worker' && headerType !== 'courier') { %>
        <div id="productPreviewModal" class="product-preview" hidden>
            <div class="product-preview__dialog">
                <button type="button" class="product-preview__close" id="productPreviewClose" aria-label="<%= typeof t === 'function' ? t('close') : 'Закрити' %>">×</button>
                <img id="productPreviewImg" class="product-preview__img" alt="" />
            </div>
        </div>
        <%- include('partials/footer') %>
        <%- include('partials/support-widget') %>
    <% } %>
    <div id="toastStack" class="toast-stack" aria-live="polite"></div>
    <button type="button" id="scroll-to-top" class="scroll-to-top" aria-label="<%= typeof t === 'function' ? t('top') : 'Прокрутити нагору' %>" title="<%= typeof t === 'function' ? t('top') : 'Нагору' %>" hidden>↑</button>
    <script src="/js/theme.js" defer></script>
    <script src="/js/lang.js" defer></script>
    <script src="/js/site-alerts.js" defer></script>
    <script src="/js/alert-settings-btn.js" defer></script>
    <script src="/js/realtime.js" defer></script>
    <% if (headerType === 'admin' || headerType === 'warehouse_worker' || headerType === 'courier' || headerType === 'user') { %>
        <script src="/js/notifications.js" defer></script>
    <% } %>
    <% if (headerType !== 'admin' && headerType !== 'warehouse_worker' && headerType !== 'courier') { %>
        <script src="/js/support-widget.js" defer></script>
    <% } %>
    <script src="/js/list-pager.js" defer></script>
    <script type="application/json" id="layoutPageConfig"><%- JSON.stringify({
        wishlistProductIds: typeof wishlistProductIds !== 'undefined' && Array.isArray(wishlistProductIds) ? wishlistProductIds : [],
        cartProductIds: typeof cartProductIds !== 'undefined' && Array.isArray(cartProductIds) ? cartProductIds : [],
        locale: {
            lang: typeof lang === 'string' ? lang : 'uk',
            usdRate: typeof usdRate !== 'undefined' ? Number(usdRate) : 41.5,
            t: typeof localeDict !== 'undefined' && localeDict ? localeDict : {}
        }
    }) %></script>
    <script>
        (function () {
            var cfg = JSON.parse(document.getElementById('layoutPageConfig').textContent);
            window.__wishlistProductIds = cfg.wishlistProductIds;
            window.__cartProductIds = cfg.cartProductIds;
            window.__locale = cfg.locale || { lang: 'uk', usdRate: 41.5, t: {} };
        })();
    </script>
    <script src="/js/locale-money.js" defer></script>
    <script src="/js/main.js" defer></script>
</body>
</html>
