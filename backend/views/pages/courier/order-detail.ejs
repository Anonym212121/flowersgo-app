<%
const o = typeof order !== 'undefined' && order ? order : {};
const safeItems = typeof items !== 'undefined' && Array.isArray(items) ? items : [];
const safeStatuses = typeof statuses !== 'undefined' && Array.isArray(statuses) ? statuses : [];
const safeTransitions = typeof statusTransitions !== 'undefined' && statusTransitions ? statusTransitions : {};
const phoneLinks = o.phone_links && o.phone_links.ok ? o.phone_links : null;
const mapsHref = typeof mapsUrl === 'string' ? mapsUrl : '';
const shiftOn = !!onShift;
const surprise = !!o.do_not_call_recipient;
const callLinks = surprise
    ? (o.buyer_phone_links && o.buyer_phone_links.ok ? o.buyer_phone_links : null)
    : phoneLinks;
let shippedStatusId = '';
let deliveredStatusId = '';
for (const s of safeStatuses) {
    if (s.status_name === 'shipped') {
        shippedStatusId = String(s.id);
    }
    if (s.status_name === 'delivered') {
        deliveredStatusId = String(s.id);
    }
}
%>

<div class="warehouse-page courier-page courier-detail-page">
    <p class="warehouse-back-link"><a href="/courier/orders">← До списку</a></p>

    <div class="warehouse-order-top">
        <div class="warehouse-order-top-main">
            <span class="warehouse-order-no">№<%= o.id %></span>
            <span class="warehouse-order-when"><%= o.delivery_display || '-' %></span>
        </div>
        <span class="warehouse-order-sum"><%= Number(o.total_price || 0).toLocaleString('uk-UA') %> грн</span>
    </div>

    <div class="warehouse-order-badges">
        <span class="warehouse-badge warehouse-badge--status"><%= o.status_label || o.status_name %></span>
        <% if (o.payment_status === 'cod') { %><span class="warehouse-badge pay-cod">При отриманні</span><% } %>
        <% if (o.is_soon) { %><span class="warehouse-badge warehouse-badge--soon">Скоро</span><% } %>
        <% if (o.is_overdue) { %><span class="warehouse-badge pay-no">Прострочено</span><% } %>
        <% if (surprise) { %><span class="warehouse-badge warehouse-badge--surprise">Сюрприз — не дзвонити</span><% } %>
        <% if (o.assembled_photo_url) { %><span class="warehouse-badge warehouse-badge--photo">Є фото букета</span><% } %>
    </div>

    <ul class="warehouse-items-list">
        <% for (const it of safeItems) { %>
            <li><%= it.product_name %> × <%= it.quantity %></li>
        <% } %>
    </ul>

    <div class="warehouse-order-details">
        <div class="warehouse-order-detail warehouse-order-detail--full">
            <span class="warehouse-order-detail-label">Кому</span>
            <span class="warehouse-order-detail-value"><%= o.receiver_name || '-' %></span>
        </div>
        <div class="warehouse-order-detail warehouse-order-detail--full">
            <span class="warehouse-order-detail-label">Адреса</span>
            <span class="warehouse-order-detail-value"><%= o.delivery_place_display || '-' %></span>
        </div>
        <% if (o.recipient_note) { %>
            <div class="warehouse-order-detail warehouse-order-detail--full">
                <span class="warehouse-order-detail-label">Примітка</span>
                <span class="warehouse-order-detail-value"><%= o.recipient_note %></span>
            </div>
        <% } %>
        <% if (surprise) { %>
            <div class="warehouse-order-detail warehouse-order-detail--full">
                <span class="warehouse-order-detail-label">Сюрприз</span>
                <span class="warehouse-order-detail-value">Не телефонуй одержувачу. Подзвони замовнику, якщо треба уточнити адресу. На місці — дзвінок у двері.</span>
            </div>
        <% } %>
        <% if (o.greeting_card_text) { %>
            <div class="warehouse-order-detail warehouse-order-detail--full">
                <span class="warehouse-order-detail-label">Листівка</span>
                <span class="warehouse-order-detail-value">(+50 грн) <%= o.greeting_card_text %></span>
            </div>
        <% } %>
        <% if (o.assembled_photo_url) { %>
            <div class="warehouse-order-detail warehouse-order-detail--full">
                <span class="warehouse-order-detail-label">Букет</span>
                <span class="warehouse-order-detail-value">
                    <img src="<%= o.assembled_photo_url %>" alt="Зібраний букет №<%= o.id %>" class="warehouse-assembled-img warehouse-assembled-img--courier" />
                </span>
            </div>
        <% } %>
    </div>

    <div class="warehouse-detail-actions">
        <% if (callLinks) { %>
            <%- include('../../partials/warehouse-phone-actions', {
                phoneLinks: callLinks,
                phoneActionsHint: surprise ? 'Дзвонити замовнику, не одержувачу' : ''
            }) %>
        <% } %>
        <% if (mapsHref) { %>
            <a class="warehouse-phone-btn warehouse-phone-btn--tg" href="<%= mapsHref %>" target="_blank" rel="noopener noreferrer" data-soft-nav="false">Маршрут</a>
        <% } %>
    </div>

    <% const successText = typeof successMessage === 'string' ? successMessage : ''; %>
    <% const errorText = typeof errorMessage === 'string' ? errorMessage : ''; %>
    <% if (successText) { %><p class="warehouse-feedback warehouse-feedback--ok"><%= successText %></p><% } %>
    <% if (errorText) { %><p class="warehouse-feedback warehouse-feedback--error"><%= errorText %></p><% } %>

    <% if (!shiftOn) { %>
        <p class="warehouse-order-cancel-msg">Зміна вимкнена - <a href="/courier/shift">увімкни</a> для зміни статусу.</p>
    <% } else if (o.status_name === 'accepted') { %>
        <p class="warehouse-feedback warehouse-feedback--ok">Доставку завершено.</p>
    <% } else if (o.status_name === 'processing') { %>
        <p class="warehouse-order-hint">Склад ще збирає букет. Як тільки буде «Готово» - забереш і натиснеш «В дорозі».</p>
    <% } else if (o.status_name === 'ready_for_pickup' && shippedStatusId) { %>
        <div class="courier-finish-block">
            <p class="courier-finish-hint">Наступний крок: забери букет на складі.</p>
            <form method="post" action="/courier/orders/<%= o.id %>/status" class="courier-finish-form">
                <input type="hidden" name="return_to" value="detail" />
                <input type="hidden" name="status_id" value="<%= shippedStatusId %>" />
                <button type="submit" class="auth-button courier-finish-btn">Забрав на складі - в дорозі</button>
            </form>
        </div>
    <% } else if (o.status_name === 'shipped' && deliveredStatusId) { %>
        <div class="courier-finish-block">
            <p class="courier-finish-hint">Наступний крок: віддай букет одержувачу.</p>
            <form method="post" action="/courier/orders/<%= o.id %>/status" class="courier-finish-form">
                <input type="hidden" name="return_to" value="detail" />
                <input type="hidden" name="status_id" value="<%= deliveredStatusId %>" />
                <button type="submit" class="auth-button courier-finish-btn">Доставлено клієнту</button>
            </form>
        </div>
    <% } else if (o.status_name === 'delivered') { %>
        <div class="courier-finish-block">
            <% if (o.payment_status === 'cod') { %>
                <p class="courier-finish-hint">Візьми оплату. Після цього замовлення закриється само.</p>
                <form method="post" action="/courier/orders/<%= o.id %>/cod-paid" class="courier-finish-form">
                    <input type="hidden" name="return_to" value="detail" />
                    <button type="submit" class="auth-button courier-finish-btn">Оплату отримано</button>
                </form>
            <% } else { %>
                <p class="warehouse-feedback warehouse-feedback--ok">Оплату вже зафіксовано. Замовлення закриється автоматично.</p>
            <% } %>
        </div>
    <% } %>
</div>
