<footer class="site-footer">
    <div class="site-footer__inner">
        <div class="site-footer__grid">
            <div class="site-footer__brand">
                <a class="site-footer__logo" href="/">
                    <span class="logo__mark" aria-hidden="true">
                        <img class="logo__mark-img" src="/images/logo-rose.png" alt="" width="32" height="32" decoding="async" />
                    </span>
                    <span class="logo__text">Flowers<span class="logo__accent">Go</span></span>
                </a>
                <p class="site-footer__about">
                    <%= t('footer.about') %>
                </p>
                <div class="site-footer__social">
                    <a href="https://t.me/" target="_blank" rel="noopener noreferrer">Telegram</a>
                    <a href="https://instagram.com/" target="_blank" rel="noopener noreferrer">Instagram</a>
                    <a href="https://viber.com/" target="_blank" rel="noopener noreferrer">Viber</a>
                </div>
            </div>

            <div class="site-footer__col">
                <h3 class="site-footer__title"><%= t('footer.delivery') %></h3>
                <ul class="site-footer__list">
                    <li><%= t('footer.d1') %></li>
                    <li><%= t('footer.d2') %></li>
                    <li><%= t('footer.d3') %></li>
                    <li><%= t('footer.d4') %></li>
                </ul>
            </div>

            <div class="site-footer__col">
                <h3 class="site-footer__title"><%= t('footer.buyers') %></h3>
                <ul class="site-footer__links">
                    <li><a href="/"><%= t('nav.catalog') %></a></li>
                    <li><a href="/cart"><%= t('nav.cart') %></a></li>
                    <li><a href="/wishlist"><%= t('nav.wishlist') %></a></li>
                    <% if (headerType === 'guest') { %>
                        <li><a href="/login"><%= t('page.login') %></a></li>
                        <li><a href="/register"><%= t('page.register') %></a></li>
                    <% } else { %>
                        <li><a href="/cabinet"><%= t('footer.cabinet') %></a></li>
                        <li><a href="/checkout?cart=1"><%= t('footer.checkout') %></a></li>
                    <% } %>
                    <li><a href="/delivery-terms"><%= t('footer.deliveryTerms') %></a></li>
                    <li><a href="/privacy"><%= t('footer.privacy') %></a></li>
                </ul>
            </div>

            <div class="site-footer__col">
                <h3 class="site-footer__title"><%= t('footer.contacts') %></h3>
                <ul class="site-footer__contacts">
                    <li><a href="tel:+380671234567">+38 (067) 123-45-67</a></li>
                    <li><a href="mailto:info@flowersgo.ua">info@flowersgo.ua</a></li>
                    <li><%= t('footer.hours') %></li>
                    <li><%= t('footer.support') %></li>
                </ul>
            </div>
        </div>

        <div class="site-footer__pay">
            <span class="site-footer__pay-label"><%= t('footer.pay') %></span>
            <span class="site-footer__badge">Visa / Mastercard</span>
            <span class="site-footer__badge">LiqPay</span>
            <span class="site-footer__badge"><%= t('footer.cash') %></span>
            <span class="site-footer__badge"><%= t('footer.cod') %></span>
        </div>

        <div class="site-footer__bottom">
            <span>© <%= new Date().getFullYear() %> FlowersGo. <%= t('footer.copy') %></span>
            <span class="site-footer__bottom-links">
                <a href="/privacy"><%= t('footer.privacyLong') %></a>
                <a href="/delivery-terms"><%= t('footer.deliveryTerms') %></a>
            </span>
        </div>
    </div>
</footer>
