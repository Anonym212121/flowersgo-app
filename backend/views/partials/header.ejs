<%
const currentNavPath = typeof navPath === 'string' ? navPath : '/';
const navCartCountNum = Number(typeof navCartCount !== 'undefined' ? navCartCount : 0);
const navWishlistCountNum = Number(typeof navWishlistCount !== 'undefined' ? navWishlistCount : 0);
const navCountLabel = (value) => {
    const n = Number(value);
    if (!Number.isFinite(n) || n <= 0) {
        return '';
    }
    return n > 99 ? '99+' : String(n);
};
const navCartBadgeLabel = navCountLabel(navCartCountNum);
const navWishlistBadgeLabel = navCountLabel(navWishlistCountNum);
const showConstructorNav = typeof constructorEnabled === 'undefined' || constructorEnabled;

const isNavActive = (href) => {
    if (!href || href === '#') {
        return false;
    }
    if (href === '/') {
        return currentNavPath === '/' || currentNavPath.startsWith('/product');
    }
    return currentNavPath === href || currentNavPath.startsWith(href + '/');
};

const navLinkClass = (href) => {
    return 'nav__link' + (isNavActive(href) ? ' nav__link--highlight' : '');
};

const navBtnClass = (href, baseClass) => {
    return baseClass + (isNavActive(href) ? ' nav__btn--active' : '');
};
%>
<header class="header" id="site-header">
    <div class="header__blur" aria-hidden="true"></div>
    <div class="header__glow" aria-hidden="true"></div>
    <div class="header__inner">
        <a class="logo" href="/">
            <span class="logo__mark" aria-hidden="true">
                <img class="logo__mark-img" src="/images/logo-rose.png" alt="" width="32" height="32" decoding="async" />
            </span>
            <span class="logo__text">Flowers<span class="logo__accent">Go</span></span>
        </a>

        <button
            type="button"
            class="header__burger"
            id="headerBurger"
            aria-label="<%= typeof t === 'function' ? t('nav.menu') : 'Відкрити меню' %>"
            aria-expanded="false"
            aria-controls="headerNav"
        >
            <span class="header__burger-line"></span>
            <span class="header__burger-line"></span>
            <span class="header__burger-line"></span>
        </button>

        <div class="nav-backdrop" id="navBackdrop" hidden></div>

        <nav class="nav" id="headerNav">
            <div class="nav__links">
                <% if (headerType === 'guest') { %>
                    <a class="<%= navLinkClass('/') %>" href="/"><%= t('nav.catalog') %></a>
                    <% if (showConstructorNav) { %>
                    <a class="<%= navLinkClass('/constructor') %>" href="/constructor"><%= t('nav.constructor') %></a>
                    <% } %>
                    <a class="<%= navLinkClass('/cart') %> nav__link--with-badge" href="/cart">
                        <%= t('nav.cart') %>
                        <span class="nav__count-badge" id="navCartBadge" <%= navCartBadgeLabel ? '' : 'hidden' %>><%= navCartBadgeLabel %></span>
                    </a>
                    <a class="<%= navLinkClass('/wishlist') %> nav__link--with-badge" href="/wishlist">
                        <%= t('nav.wishlist') %>
                        <span class="nav__count-badge" id="navWishlistBadge" <%= navWishlistBadgeLabel ? '' : 'hidden' %>><%= navWishlistBadgeLabel %></span>
                    </a>
                <% } else if (headerType === 'admin') { %>
                    <a class="<%= navLinkClass('/') %>" href="/"><%= t('nav.site') %></a>
                    <a class="<%= navLinkClass('/admin') %>" href="/admin"><%= t('nav.admin') %></a>
                <% } else if (headerType === 'warehouse_worker') { %>
                    <a class="<%= navLinkClass('/') %>" href="/"><%= t('nav.site') %></a>
                    <a class="<%= navLinkClass('/warehouse/orders') %>" href="/warehouse/orders"><%= t('nav.warehouseOrders') %></a>
                    <a class="<%= navLinkClass('/warehouse/stock') %>" href="/warehouse/stock"><%= t('nav.warehouseStock') %></a>
                <% } else if (headerType === 'courier') { %>
                    <a class="<%= navLinkClass('/') %>" href="/"><%= t('nav.site') %></a>
                    <a class="<%= navLinkClass('/courier/orders') %>" href="/courier/orders"><%= t('nav.courierOrders') %></a>
                    <a class="<%= navLinkClass('/courier/shift') %>" href="/courier/shift"><%= t('nav.courierShift') %></a>
                <% } else { %>
                    <a class="<%= navLinkClass('/') %>" href="/"><%= t('nav.catalog') %></a>
                    <% if (showConstructorNav) { %>
                    <a class="<%= navLinkClass('/constructor') %>" href="/constructor"><%= t('nav.constructor') %></a>
                    <% } %>
                    <a class="<%= navLinkClass('/cart') %> nav__link--with-badge" href="/cart">
                        <%= t('nav.cart') %>
                        <span class="nav__count-badge" id="navCartBadge" <%= navCartBadgeLabel ? '' : 'hidden' %>><%= navCartBadgeLabel %></span>
                    </a>
                    <a class="<%= navLinkClass('/wishlist') %> nav__link--with-badge" href="/wishlist">
                        <%= t('nav.wishlist') %>
                        <span class="nav__count-badge" id="navWishlistBadge" <%= navWishlistBadgeLabel ? '' : 'hidden' %>><%= navWishlistBadgeLabel %></span>
                    </a>
                    <a class="<%= navLinkClass('/cabinet') %>" href="/cabinet?tab=profile"><%= t('nav.cabinet') %></a>
                <% } %>
            </div>

            <div class="nav__actions">
                <label class="theme-switch" title="<%= t('nav.themeTitle') %>">
                    <input type="checkbox" id="themeToggle" aria-label="<%= t('nav.themeLight') %>">
                    <span class="theme-switch__ui" aria-hidden="true"></span>
                    <span class="theme-switch__text"><%= t('nav.theme') %></span>
                </label>
                <label class="theme-switch" title="<%= t('nav.lang') %>">
                    <input type="checkbox" id="langToggle" aria-label="<%= t('nav.lang') %>"<%= typeof lang === 'string' && lang === 'en' ? ' checked' : '' %>>
                    <span class="theme-switch__ui" aria-hidden="true"></span>
                    <span class="theme-switch__text"><%= t('nav.lang') %></span>
                </label>
                <div class="nav-settings" id="navSettings">
                    <button type="button" class="nav-settings__btn" id="navSettingsBtn" aria-label="<%= t('nav.settings') %>" aria-expanded="false" aria-controls="navSettingsPanel" title="<%= t('nav.settings') %>">
                        <span class="nav-settings__icon" aria-hidden="true">⚙</span>
                    </button>
                    <div class="nav-settings__panel" id="navSettingsPanel" hidden>
                        <div class="nav-settings__head">
                            <strong><%= t('nav.settings') %></strong>
                        </div>
                        <section class="nav-settings__section" aria-labelledby="navSettingsAlertsTitle">
                            <h3 class="nav-settings__section-title" id="navSettingsAlertsTitle"><%= t('nav.alerts') %></h3>
                            <div id="navAlertSettings"></div>
                        </section>
                    </div>
                </div>
                <% if (headerType === 'admin' || headerType === 'warehouse_worker' || headerType === 'courier' || headerType === 'user') { %>
                    <div class="nav-notify" id="navNotify">
                        <button type="button" class="nav-notify__btn" id="navNotifyBtn" aria-label="<%= t('nav.notify') %>" aria-expanded="false">
                            <span class="nav-notify__icon" aria-hidden="true">🔔</span>
                            <span class="nav-notify__badge" id="navNotifyBadge" hidden>0</span>
                        </button>
                        <div class="nav-notify__panel" id="navNotifyPanel" hidden>
                            <div class="nav-notify__head">
                                <strong><%= t('nav.notify') %></strong>
                                <button type="button" class="nav-notify__read-all" id="navNotifyReadAll"><%= t('nav.notifyAll') %></button>
                            </div>
                            <ul class="nav-notify__list" id="navNotifyList"></ul>
                            <p class="nav-notify__empty" id="navNotifyEmpty" hidden><%= t('nav.notifyEmpty') %></p>
                            <div class="nav-notify__pager list-pager-controls" id="navNotifyPager" hidden>
                                <span class="list-pager-info" id="navNotifyPagerInfo"></span>
                                <div class="list-pager-actions">
                                    <button type="button" class="list-pager-more auth-button" id="navNotifyMore"><%= t('nav.notifyMore') %></button>
                                    <button type="button" class="list-pager-all admin-secondary-btn" id="navNotifyAll"><%= t('nav.notifyShowAll') %></button>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
                <% if (headerType === 'guest') { %>
                    <a class="<%= navBtnClass('/login', 'nav__btn nav__btn--ghost') %>" href="/login"><%= t('nav.login') %></a>
                    <a class="<%= navBtnClass('/register', 'nav__btn nav__btn--primary') %>" href="/register"><%= t('nav.register') %></a>
                <% } else { %>
                    <a class="nav__btn nav__btn--ghost" href="/logout" data-soft-nav="false"><%= t('nav.logout') %></a>
                <% } %>
            </div>
        </nav>
    </div>
</header>
